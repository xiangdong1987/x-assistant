# Proxy 本地配置（含本机路径，使用 *.example.json 复制后修改）
proxy/config/projects.json
proxy/config/skill_paths.json

# 内部计划文档（含本机路径等，不随开源发布）
docs/plan-*.md

# 技能：data 目录下均为本地/运行时数据，不提交到 git（schedules.json、links.json、events/*.json 等）
skills/schedule/data/*
skills/schedule/data/events/*
!skills/schedule/data/events/.gitkeep
skills/software-dev/data/task-definitions/*
!skills/software-dev/data/task-definitions/.gitkeep

# 技能：不纳入版本控制（内部/私有）
skills/db-query/
skills/italia-company-lookup/

ios/Podfile.lock
macos/Podfile.lock
pubspec.lock