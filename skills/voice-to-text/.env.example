# Google Cloud Speech-to-Text API Key
# 获取步骤见下方说明
GOOGLE_SPEECH_API_KEY=xxxxxxxxxx

# 模型选择（可选，默认 enhanced）
#   enhanced → SKU 7247-19E1-FB4D，latest_short，准确率最高，适合短语音（推荐）
#   long     → SKU 7247-19E1-FB4D，latest_long，适合超过 1 分钟的录音
#   standard → SKU 6649-62EF-CB8F，default，标准精度，免费额度更多
# VOICE_MODEL=enhanced
