# Claude Voice Proxy - Environment Configuration Example
# Copy this file to .env and customize the values as needed
#
# Usage:
#   1. cp .env.example .env
#   2. Edit .env with your desired configuration
#   3. Run: set -a; source .env; set +a; ./start_server.sh
#   Or export variables before running: export $(cat .env | xargs) && ./start_server.sh

# ==============================================================================
# Server Configuration
# ==============================================================================

# Server host (default: 0.0.0.0)
# PROXY_HOST=0.0.0.0

# Server port (default: 8443)
# PROXY_PORT=8443

# ==============================================================================
# MCP Configuration
# ==============================================================================

# MCP transport type: stdio or http (default: stdio)
# MCP_TRANSPORT=stdio

# Path to Cursor executable (default: cursor)
# MCP_CURSOR_PATH=/Applications/Cursor.app/Contents/MacOS/Cursor

# MCP HTTP port (only used when MCP_TRANSPORT=http, default: 3000)
# MCP_HTTP_PORT=3000

# MCP HTTP host (only used when MCP_TRANSPORT=http, default: localhost)
# MCP_HTTP_HOST=localhost

# MCP session timeout in seconds (default: 3600)
# MCP_SESSION_TIMEOUT=3600

# MCP log level: debug, info, warn, error (default: info)
# MCP_LOG_LEVEL=info

# ==============================================================================
# OpenClaw Gateway Configuration
# ==============================================================================

# Enable OpenClaw integration (default: false)
# Set to "true" to enable
# OPENCLAW_ENABLED=false

# OpenClaw Gateway WebSocket URL (default: ws://127.0.0.1:18789)
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# OpenClaw Gateway authentication token (required when enabled)
# OPENCLAW_GATEWAY_TOKEN=your-token-here

# Reconnect interval in seconds when connection is lost (default: 5)
# OPENCLAW_RECONNECT_INTERVAL=5

# Stream idle timeout in seconds before sending complete (default: 300)
# OPENCLAW_STREAM_IDLE=300

# Pending request cleanup interval in seconds (default: 30)
# OPENCLAW_CLEANUP_INTERVAL=30

# ==============================================================================
# Task Management Intervals
# ==============================================================================

# Task status sync interval in seconds (default: 5)
# This controls how often the server checks task files for status changes
# TASK_SYNC_INTERVAL=5

# Phase watcher interval in seconds (default: 20)
# This controls how often the server checks for tasks that need to advance to the next phase
# PHASE_WATCHER_INTERVAL=20

# ==============================================================================
# Other Configuration
# ==============================================================================

# Allow /api/tasks without JWT when request is from localhost (default: false)
# Set to "true" to allow (useful for skill scripts during development)
# ALLOW_LOCAL_NO_AUTH=false

# Working directory for Claude Code (default: current directory)
# PROXY_WORKDIR=/path/to/your/project

# Skill paths: absolute paths, colon-separated (semicolon on Windows).
# Overrides proxy/config/skill_paths.json. Example:
# XASSISTANT_SKILL_PATHS=/path/to/xassistant/skills
# Or multiple: /path/to/skills1:/path/to/skills2
